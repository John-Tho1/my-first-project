# Codex 프로젝트 스코프 설정 예시
#
#   cp .codex/config.toml.example .codex/config.toml
#
# 실제 .codex/config.toml 은 .gitignore 처리되어 있다(로컬 경로·인증이 들어갈 수 있으므로).
# 전역 설정은 ~/.codex/config.toml 에 둔다.

# 기본 승인/샌드박스 정책 — 이 저장소에서는 절대 danger-full-access 를 쓰지 않는다.
approval_policy = "on-request"
sandbox_mode    = "workspace-write"

# ── Claude Code를 Codex의 MCP 서버로 붙인다 ────────────────────────────
# 이렇게 하면 Codex 세션 안에서 Claude Code의 도구(파일 편집·검색 등)를 호출할 수 있다.
# 등록: codex mcp add claude-code -- claude mcp serve
[mcp_servers.claude-code]
command = "claude"
args    = ["mcp", "serve"]
startup_timeout_sec = 30
tool_timeout_sec    = 300

# ── 리뷰 전용 프로필 ───────────────────────────────────────────────────
# 사용: codex --profile reviewer  /  codex exec --profile reviewer "..."
[profiles.reviewer]
approval_policy = "never"
sandbox_mode    = "read-only"
