# Content Studio — Caddy 예시(T21-P2, 파일만 · 배포한 적 없음 · 실제 서버에서 검증하지 않음)
# 사용: /etc/caddy/Caddyfile 로 복사. APP_DOMAIN 은 /etc/caddy/content-studio.env(APP_DOMAIN=<도메인> 한 줄) 한 곳에 두고
#   Caddy 서비스(systemctl edit caddy → [Service] EnvironmentFile=/etc/caddy/content-studio.env)와 `caddy validate` 가 같은 파일을 읽게 한다
#   (deploy/README_KO.md §6 — FIX1-T21P2: 검증 명령에도 같은 값을 넘긴다). 도메인 값은 사용자가 정한다.
#
# - 자동 HTTPS: Caddy 가 Let's Encrypt 인증서를 받고 http → https 로 넘긴다(80·443 이 열려 있어야 함).
# - web 은 127.0.0.1:3000 에서만 듣는다(systemd unit 의 --hostname 127.0.0.1). 외부에서 3000 으로 직접 들어올 수 없다.
# - 앱 전체가 로그인 뒤에 있다. 로그인 없이 열리는 것은 생존 확인 GET /api/health(응답 { status, app, time_utc, db_ok } — T21-P3)와 로그인 화면뿐이다.
# - 앱은 X-Forwarded-* 를 신뢰하지 않는다(CSRF 검사는 Origin 과 APP_BASE_URL 비교). APP_BASE_URL=https://<APP_DOMAIN> 이어야 한다.

{
	# 인증서 만료 알림을 받을 주소(선택, placeholder). 비워 두면 알림 없이 발급한다.
	# email ops@example.com
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		# HTTPS 만 쓰도록(1년). 하위 도메인·preload 는 넣지 않는다(도메인 전체 정책은 사용자 결정).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# 마이크는 이 앱(녹음 화면)만, 카메라·위치는 쓰지 않는다
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# Content-Security-Policy 는 넣지 않았다 — Next 의 인라인 스크립트에 nonce 설정이 필요하다(별도 작업, 남은 위험).

	reverse_proxy 127.0.0.1:3000
}
