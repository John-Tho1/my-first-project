# Content Studio 환경변수 예시 — placeholder 만. 실제 키·토큰·비밀번호를 넣지 않는다.
# 사용: cp .env.example .env.local  (.env.local 은 gitignore 대상)
# 상대 경로는 워크스페이스 루트(이 파일이 있는 폴더) 기준으로 해석한다.

APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Europe/Moscow

# DB: M0–M2 는 pglite(PostgreSQL WASM). postgres 는 M3 에서 구현.
# PGlite 는 한 데이터 디렉터리를 한 프로세스만 열 수 있다. dev 서버 실행 중에는 db:seed / worker 를 돌리지 않는다.
DB_DRIVER=pglite
DATABASE_URL=./data/pglite

# 기본값: AI 모의, 게시 비활성, 수집 비활성 (기본 모드에서 외부 쓰기 0)
LLM_MODE=mock
LLM_PROVIDER=
LLM_MODEL=
# T07(결정 D13): 실제 AI 호출은 사용자의 별도 승인 뒤에만.
# 승인 기록 참조(예: 결정 ID). 승인 전에는 비워 둔다.
LLM_LIVE_APPROVAL_REF=
# 예산(A15): 금액은 소수 6자리까지. 가격이 비어 있으면 live 차단, mock 은 0 으로 기록(한도 검사 없음).
LLM_BUDGET_CURRENCY=USD
LLM_BUDGET_MONTHLY_LIMIT=
LLM_BUDGET_PER_RUN_MAX=
LLM_PRICE_INPUT_PER_1K=
LLM_PRICE_OUTPUT_PER_1K=
# LIVE-L1(결정 D34): 실제 Claude(Anthropic) 블록 — 주석 그대로 두고, 2단계 승인 뒤 사용자가 .env.local 에 직접 옮긴다.
# 이 파일에는 키 값을 절대 넣지 않는다. 화면·health 에는 "빠진 조건 이름"만 보인다.
# LLM_MODE=live
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# 단가(2026-10 공식 가격 입력 4 USD·출력 20 USD / 1M 토큰). 모델을 바꾸면 단가도 함께 바꾼다.
# LLM_PRICE_INPUT_PER_1K=0.004
# LLM_PRICE_OUTPUT_PER_1K=0.02
# LLM_BUDGET_MONTHLY_LIMIT=10
# 1회 예약 상한 제안(잠정): 0.5 USD. 예약(보수적 추정 — 증명된 비용 상한 아님) = (프롬프트 UTF-8 바이트 + 고정분 + 여유 2048) × 입력 단가
#   + 출력 상한 × 출력 단가. 보통 원고(한글 4천 자) ≈ 0.15 USD, 0.5 이면 한글 약 3만 자 프롬프트까지 허용. 더 크면 429(호출 안 함).
#   확정액(이 앱의 예산 기록 — Anthropic 청구액과 같다고 보장하지 않음):
#     성공 + 공급자 사용량 보고 → 보고 토큰 × 설정 단가 / 실패 + 사용량 보고 → max(예약액, 보고 비용) /
#     사용량 모름(보고 없음·형식 오류·응답 없음) → 예약액 / 보고값이 기록 범위 밖 → 예약액 + 보고값 보존, 운영자가 정리할 때까지 새 실제 호출 차단.
#   확정액 > 예약액이면 초과액을 기록한다. 1회 상한은 예약 추정에만 적용된다(실제액이 넘어도 그 요청은 이미 끝남).
#   다음 요청은 월 합계(초과액 포함) + 예약액이 월 상한을 넘을 때 거부된다. 동시에 진행 중인 호출들이 각각 예약을 넘으면
#   초과액이 합쳐져 월 상한을 그만큼 넘을 수 있다 — 한 호출분으로 묶이는 것은 LLM_LIVE_MAX_RUNS=1 일 때뿐. 단가는 0~100(1K 토큰당)만 허용.
# LLM_BUDGET_PER_RUN_MAX=0.5
# 같은 승인 기록(LLM_LIVE_APPROVAL_REF)으로 허용하는 실제 호출 횟수(실패 포함). D34 2단계(실제 호출 1회 확인)에는 1 을 권한다.
# LLM_LIVE_MAX_RUNS=1
# 1회 출력 토큰 상한(= 요청 max_tokens, 1024~16000, 기본 4096). thinking 토큰도 출력으로 과금된다.
# LLM_LIVE_MAX_OUTPUT_TOKENS=4096
# 키는 사용자가 .env.local 에만 직접 넣는다(서버 전용 — 브라우저·로그·저장소·프롬프트에 값 없음).
# ANTHROPIC_API_KEY=
# LLM_LIVE_APPROVAL_REF 는 사용자가 D34 2단계(실제 호출 1회 확인)를 승인한 뒤에만 설정한다(예: D34-2). 비어 있으면 live 는 503.
# T08(결정 D9·D15): 음성 전사. 기본 mock(결정적 모의 전사기, 외부 호출 없음).
# live 는 승인 기록·공급자·모델·가격을 모두 채워도 T08 에는 어댑터가 없어 거부된다. 예산 통화·상한은 LLM_BUDGET_* 공용.
STT_MODE=mock
STT_PROVIDER=
STT_MODEL=
STT_LIVE_APPROVAL_REF=
# 음성 1분 가격(소수 6자리까지). 비어 있으면 mock 은 0 으로 기록.
STT_PRICE_PER_MINUTE=
PUBLISH_MODE=disabled
# 수집: disabled(기본) | mock(T19 모의 수집기 — 고정 합성 자료, 실제 웹 요청 0) | enabled(실제 수집 — 수집기 없음, 준비 안 됨)
COLLECTOR_MODE=disabled
# 주기 수집: off(기본) | on(모의 모드일 때만 기한이 된 소스의 미리보기만 만든다 — 소재 자동 생성 없음)
COLLECTOR_SCHEDULER=off

# inline: worker 를 web 프로세스 안에서 실행(PGlite 제약). separate 는 postgres 에서만.
WORKER_MODE=inline
# T21-P2: inline 일 때 web 안 타이머로 작업 처리기를 주기 실행하는 간격(초). 0(기본) = 끔(로그인한 요청 때만 처리), 켜면 5~600.
#   직전 처리가 끝난 뒤 이 간격만큼 쉬고 다음 처리(겹치지 않음). 로컬 개발은 0 그대로 두어도 된다. 운영 권장 30(deploy/README_KO.md).
WORKER_INLINE_INTERVAL_SECONDS=0

# 단일 사용자 허용 식별자(placeholder)
AUTH_ALLOWED_IDENTITY=owner@example.local
# 인증 방식(T02, 결정 D3): dev = 비밀번호 없는 개발용 로그인(APP_BASE_URL 이 localhost/127.0.0.1 일 때만 허용)
#                         oidc = 운영 인증(T21-P1b) — 일반 OpenID Connect 로그인(아래 OIDC_*). 이 모드에서는 식별자 입력 로그인을 거부한다.
#   T21-P1a: 운영 빌드(pnpm build/pnpm start, NODE_ENV=production)에서는 dev 를 거부한다(서버 시작·설정 읽기·로그인). worker·DB 스크립트를 NODE_ENV=production 으로 돌릴 때도 AUTH_MODE=oidc 필요. 로컬은 pnpm dev.
AUTH_MODE=dev
# T21-P1b OIDC 로그인(AUTH_MODE=oidc 일 때). IdP 는 정하지 않는다(Google 등은 사용자가 고르고, IdP 콘솔에서 클라이언트를 직접 만든다 — 실제 IdP 연결은 별도 승인).
#   허용 신원: AUTH_ALLOWED_IDENTITY 를 명시하면 ID token 의 email 이 같고(대소문자 무시) email_verified=true 여야 한다.
#             AUTH_ALLOWED_SUBJECT 를 설정하면 sub 가 정확히 같아야 한다. 둘 다 설정하면 둘 다. 둘 중 하나는 반드시 설정한다(다른 사용자는 만들지 않는다).
#   SECRETS_MASTER_KEY(아래)도 필요하다 — 로그인 요청의 PKCE verifier·nonce 를 10분 동안 봉인해 둔다.
#   준비 상태(빠진 설정 이름)는 로그인 후 설정 화면·GET /api/health/details, 로그인 전에는 서버 로그([auth] oidc_not_configured: …)에서 본다.
# 발급자 URL(https 만, discovery = 이 값 + /.well-known/openid-configuration). 예시는 placeholder.
OIDC_ISSUER_URL=
# IdP 에서 받은 클라이언트 ID(placeholder)
OIDC_CLIENT_ID=
# 클라이언트 시크릿 — 서버 환경(.env.local·운영 환경 파일)에만. 이 파일·저장소·로그·화면에 넣지 않는다.
OIDC_CLIENT_SECRET=
# IdP 에 등록할 redirect URI — APP_BASE_URL 의 origin + /api/auth/oidc/callback 과 정확히 같아야 한다(예: https://studio.example.com/api/auth/oidc/callback).
OIDC_REDIRECT_URI=
# 요청 scope(공백 구분, openid 필수). email 로 확인하면 email 도 필요. 기본 "openid email".
OIDC_SCOPES=openid email
# (선택) 허용할 ID token sub. 비우면 email 로만 확인한다.
AUTH_ALLOWED_SUBJECT=
# 세션 유효 시간(분, 5~43200). 기본 720 = 12시간
AUTH_SESSION_TTL_MINUTES=720
# 세션 쿠키 Secure 속성: auto(http://localhost·127.0.0.1 이면 끔, 그 외 켬) | true | false
AUTH_COOKIE_SECURE=auto

# 파일 저장소: local(개발, 워크스페이스 루트 기준 경로) | object(미구현 → 거부)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/assets

# 내보내기·복원(T05): 묶음 ZIP 과 복원용으로 올린 ZIP 을 두는 곳(개인 원문 포함 — data/ 는 gitignore 대상)
EXPORT_LOCAL_DIR=./data/exports
RESTORE_LOCAL_DIR=./data/restores

# 가져오기(T18, D32 제안): 미리보기용으로 올린 Notion·Drive 내보내기 ZIP 을 확정·취소 전까지 두는 곳(개인 원문 포함 — gitignore)
IMPORT_LOCAL_DIR=./data/imports
# Notion·Drive 직접 연결(커넥터) 자리: disabled(기본) | mock(합성 자료만, 외부 호출 0). live 값은 없다 — 자격 증명은 이 파일에 넣지 않는다.
IMPORT_CONNECTOR_MODE=disabled

# 배포 작업 처리기(T11, 결정 D18): 어댑터 전송 시간 제한(ms, 1000~600000, 기본 30000). 넘으면 결과 불명 → 재전송 없이 원격 조회.
JOB_SUBMIT_TIMEOUT_MS=30000
# 화면 "작업 처리 실행(모의 1회)" 버튼의 작업당 전송 시간 제한(ms, 기본 10000) — 응답 없는 전송이 화면을 오래 붙잡지 않게
WORKER_UI_TICK_TIMEOUT_MS=10000
# 모의 채널 결과 시나리오(개발·테스트 전용, 운영 빌드에서는 무시): success | transient | permanent | auth |
#   ambiguous_sent | ambiguous_not_sent | processing_then_confirm | hang. 비우면 success. 실제 채널로는 아무것도 보내지 않는다.
MOCK_CHANNEL_SCENARIO=
# T20(결정 D22) 운영·보존. 외부 알림(이메일·메시지)은 없다 — /ops 화면이 알림이다.
# 마지막 내보내기(백업)가 이 시간보다 오래되면 /ops 에 경고(1~8760, 기본 24)
BACKUP_MAX_AGE_HOURS=24
# 배포 파일 ZIP(수동 게시용, 다시 만들 수 있음) 보존 일수(파일 수정 시각 기준, 1~3650, 기본 30)
RETENTION_PACKAGES_DAYS=30
# owner 마다 남길 최근 내보내기 ZIP 수(1~1000, 기본 10). 실행 기록(export_runs)은 남긴다
RETENTION_EXPORT_RUNS_KEEP=10
# 끝난 배포 작업(CONFIRMED·FAILED·CANCELED)의 이력 보존 일수(1~3650, 기본 180). 지우기 전에 EXPORT_LOCAL_DIR/retention/ 에 JSONL 로 보관
RETENTION_JOB_EVENTS_DAYS=180
# manual(기본) = /ops 에서 미리보기 확인 후 confirm 으로만 적용, auto = 작업 처리기가 한 시간에 한 번 적용
RETENTION_SWEEP_MODE=manual
# 업로드 세션은 24시간 뒤 자동 만료·조각 삭제(D15, 고정값 — 설정 없음). 앱은 파일 로그를 쓰지 않으므로 로그 보존 기간(RETENTION_LOG_DAYS)은 설정이 없다.

# T13(결정 D24) 계정 연결(OAuth)·비밀 보호. 모든 값은 placeholder — 실제 키·앱 비밀을 이 파일에 넣지 않는다(.env.local 에만).
# 서버 비밀 암호화 마스터 키: base64 로 디코딩하면 정확히 32바이트(예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# 비어 있으면 계정 연결만 503(secrets_not_configured), 나머지 앱은 그대로. 기본·개발용 키는 없다. DB·백업·export 에 들어가지 않는다.
SECRETS_MASTER_KEY=
SECRETS_KEY_VERSION=1
# 키 교체 기간에만: 직전 키와 그 버전(복호화·재암호화용). 교체가 끝나면 비운다.
SECRETS_MASTER_KEY_PREVIOUS=
SECRETS_KEY_VERSION_PREVIOUS=
# mock(기본) = Threads 모의 계정만 앱 안 모의 공급자로 연결(외부 호출 0). live 는 T13 에 어댑터가 없어 항상 거부된다.
OAUTH_MODE=mock
# callback 정확 일치 대상. 비우면 APP_BASE_URL + /api/oauth/callback
OAUTH_REDIRECT_URI=
# 실제 계정 연결 승인 기록 참조(예: 결정 ID). 승인 전에는 비워 둔다.
OAUTH_LIVE_APPROVAL_REF=
# Threads 앱(실제 연결은 T14, 별도 승인 후). 화면에는 설정 여부만 보인다.
THREADS_APP_ID=
THREADS_APP_SECRET=
