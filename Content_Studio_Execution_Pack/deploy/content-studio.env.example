# Content Studio 운영 환경 파일 예시(T21-P2) — 서버의 /etc/content-studio/env 로 복사해 고친다. chown root:root, chmod 600.
# 이 파일(예시)에는 placeholder 만 있다. 실제 값(도메인·키)은 서버의 /etc/content-studio/env 에만 사용자가 직접 넣는다 — 저장소·대화·로그에 남기지 않는다.
# 형식: systemd EnvironmentFile(KEY=VALUE, 따옴표·변수 확장 없이). 값 설명은 저장소 루트 .env.example.
# 승인 범위 초안(docs/handoffs/T21_DEPLOY_REVIEW.md §4.2)의 "고정 설정"과 같다. 바꾸려면 별도 승인.

APP_BASE_URL=https://studio.example.com
APP_TIMEZONE=Europe/Moscow

# 운영 인증: dev 는 운영 빌드에서 거부된다(T21-P1a). oidc 는 아직 미구현이라 모든 로그인이 거부된다(T21-P1b 전에는 배포 불가).
AUTH_MODE=oidc
AUTH_ALLOWED_IDENTITY=owner@example.local
AUTH_SESSION_TTL_MINUTES=720
AUTH_COOKIE_SECURE=auto

# DB·파일: 영속 디스크의 절대 경로(재배포·재시작 뒤에도 남는 곳). 한 프로세스만 연다.
DB_DRIVER=pglite
DATABASE_URL=/srv/content-studio/data/pglite
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/srv/content-studio/data/assets
EXPORT_LOCAL_DIR=/srv/content-studio/data/exports
RESTORE_LOCAL_DIR=/srv/content-studio/data/restores
IMPORT_LOCAL_DIR=/srv/content-studio/data/imports

# 작업 처리기: web 안(inline) + 주기 처리 30초(T21-P2). 0 이면 꺼짐(요청이 있을 때만 처리) — 서버 시작 로그에 경고가 남는다.
WORKER_MODE=inline
WORKER_INLINE_INTERVAL_SECONDS=30

# 외부 효과는 모두 끔·모의(각각 별도 승인 전까지 바꾸지 않는다)
PUBLISH_MODE=disabled
COLLECTOR_MODE=disabled
COLLECTOR_SCHEDULER=off
IMPORT_CONNECTOR_MODE=disabled
OAUTH_MODE=mock
LLM_MODE=mock
STT_MODE=mock
LLM_LIVE_APPROVAL_REF=
OAUTH_LIVE_APPROVAL_REF=
RETENTION_SWEEP_MODE=manual

# 서버 비밀 암호화 마스터 키(운영 전용 새 키 — 로컬 키를 재사용하지 않는다). 비워 두면 계정 연결만 503, 나머지 앱은 동작.
# 만들기(서버에서, 출력은 화면에만): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=
# 넣지 않음(각각 별도 승인): ANTHROPIC_API_KEY, THREADS_APP_ID, THREADS_APP_SECRET
